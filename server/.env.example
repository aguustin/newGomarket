# Copiar a server/.env y completar. Nunca versionar server/.env.

# --- Entorno ---
# development: usa MP_ACCESS_TOKEN_DEV (sandbox) y las URLs *_DEV. Sin definir = produccion.
APP_ENV=development
PORT=4000

# --- Base de datos (MongoDB Atlas). Indicar el nombre de la base en la ruta. ---
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/NOMBRE_BASE
# Opcional: fuerza otro nombre de base en el mismo cluster (los tests usan ipass_test automaticamente)
# MONGO_DB_NAME=

# --- URLs publicas (links en mails/QR, back_urls y webhook de Mercado Pago) ---
URL_FRONT=https://www.ipassi.com
URL_BACK=https://gomarket-1-backend.onrender.com
URL_FRONT_DEV=http://localhost:5173
# En dev debe ser la URL https de ngrok (sin barra final) para recibir el webhook
URL_BACK_DEV=https://xxxx.ngrok-free.app

# --- Mercado Pago (Access Token; empiezan con APP_USR-) ---
MP_ACCESS_TOKEN_DEV=
MP_ACCESS_TOKEN_PROD=

# --- Seguridad (obligatorias en todos los entornos; usar 32+ caracteres al azar) ---
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SECRET_MAIL_KEY=
# Rotar JWT_SECRET: poner la clave vieja aca y la nueva en JWT_SECRET. Los QR ya vendidos siguen valiendo
# (la vieja solo sirve para leerlos); las sesiones se cierran. Se puede borrar despues del ultimo evento con QR viejos.
# JWT_SECRET_ANTERIOR=
# Rotar SECRET_MAIL_KEY: clave vieja aca, nueva en SECRET_MAIL_KEY y correr scripts/rotarSecretMailKey.js; despues borrarla
# SECRET_MAIL_KEY_ANTERIOR=

# --- Mails ---
# resend  = envia de verdad (por defecto, el unico valido en produccion junto con off)
# bandeja = no envia: guarda los mails y se ven en http://localhost:4000/dev/mails (solo development/test)
# falla   = simula que el proveedor rechaza el envio, para probar errores (solo development/test)
# off     = no envia ni guarda, solo deja registro en consola
MAIL_MODE=bandeja
RESEND_API_KEY=
# Avisos al administrador (reembolsos para revisar, sobreventas, montos distintos, entregas fallidas) y mensajes del formulario de contacto
ADMIN_MAIL=
# reCAPTCHA v2: clave SECRETA (la del sitio va en el cliente, VITE_RECAPTCHA_KEY). Vacia = no se verifica (solo local)
RECAPTCHA_SECRET=

# --- Cloudinary (imagenes) ---
CLOUD_NAME=
API_KEY=
API_SECRET=


# --- Webhooks de Mercado Pago ---
# Clave secreta de la aplicacion de MP (panel de developers > Webhooks > clave secreta)
WEBHOOK_SECRET_KEY=
# registrar = verifica la firma de los avisos de MP y lo deja en el log (procesa igual) | estricto = rechaza los sin firma valida | off
WEBHOOK_FIRMA=registrar

# --- Definidas pero sin uso en el codigo actual ---
