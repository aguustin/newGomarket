# Copiar a server/.env y completar. Nunca versionar server/.env.

# --- Entorno ---
# development: usa MP_ACCESS_TOKEN_DEV (sandbox) y las URLs *_DEV. Sin definir = produccion.
APP_ENV=development
PORT=4000

# --- Base de datos (MongoDB Atlas). Indicar el nombre de la base en la ruta. ---
MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/NOMBRE_BASE
# Opcional: fuerza otro nombre de base en el mismo cluster (los tests usan ipass_test automaticamente)
# MONGO_DB_NAME=

# --- URLs publicas (links en mails/QR, back_urls y webhook de Mercado Pago) ---
URL_FRONT=https://www.ipassi.com
URL_BACK=https://gomarket-1-backend.onrender.com
URL_FRONT_DEV=http://localhost:5173
# En dev debe ser la URL https de ngrok (sin barra final) para recibir el webhook
URL_BACK_DEV=https://xxxx.ngrok-free.app

# --- Mercado Pago (Access Token; empiezan con APP_USR-) ---
MP_ACCESS_TOKEN_DEV=
MP_ACCESS_TOKEN_PROD=

# --- Seguridad. Cambiar JWT_SECRET invalida los QR emitidos; cambiar SECRET_MAIL_KEY rompe los mails cifrados guardados ---
JWT_SECRET=
SECRET_MAIL_KEY=

# --- Mails ---
# resend  = envia de verdad (por defecto, el unico valido en produccion junto con off)
# bandeja = no envia: guarda los mails y se ven en http://localhost:4000/dev/mails (solo development/test)
# falla   = simula que el proveedor rechaza el envio, para probar errores (solo development/test)
# off     = no envia ni guarda, solo deja registro en consola
MAIL_MODE=bandeja
RESEND_API_KEY=
# Gmail (contacto y cortesias por Excel): cuenta y contraseña de aplicacion
USER_MAIL=
PASS=

# --- Cloudinary (imagenes) ---
CLOUD_NAME=
API_KEY=
API_SECRET=

# --- Redis (cola del worker; hoy sin uso) ---
REDIS_URL=

# --- Definidas pero sin uso en el codigo actual ---
# WEBHOOK_SECRET_KEY=   (previsto para validar la firma del webhook de MP)
