# Copiar a client/.env y completar. Todo lo que empieza con VITE_ queda PUBLICO
# dentro del bundle: no poner aca claves secretas.

# URL del backend
VITE_URL=http://localhost:4000
# URL de este frontend (links copiados)
VITE_URL_FRONT=http://localhost:5173

# reCAPTCHA: clave del SITIO (publica). La clave secreta va solo en el backend.
VITE_RECAPTCHA_KEY=
# false = oculta el captcha en login y registro (usar en client/.env.local para desarrollo)
VITE_RECAPTCHA_ENABLED=false
